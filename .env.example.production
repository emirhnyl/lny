# Production Environment Variables
# Hostinger'da kullanılacak .env dosyası için şablon

# Database
DATABASE_URL="file:./prisma/dev.db"

# NextAuth - ÖNEMLI: Güçlü bir şifre oluşturun!
# Şifre oluşturmak için: openssl rand -base64 32
NEXTAUTH_SECRET="BURAYA-GÜÇLÜ-BİR-ŞİFRE-YAZIN"
NEXTAUTH_URL="https://lnarge.com"

# Site Configuration  
NEXT_PUBLIC_SITE_URL=https://lnarge.com

# Hostinger Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@lnarge.com
SMTP_PASS=EMAIL-ŞİFRENİZ

# Email routing
MAIL_TO=info@lnarge.com

# Environment
NODE_ENV=production
